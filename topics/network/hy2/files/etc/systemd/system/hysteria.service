[Unit]
Description=Tailnet and public Hysteria2 proxy
After=network-online.target hy2-subscriptions.service hysteria-firewall.service
Wants=network-online.target
Requires=hy2-subscriptions.service hysteria-firewall.service

[Service]
ExecStart=/usr/local/bin/hysteria server -c /etc/hysteria/config.yaml
User=hysteria
Group=hysteria
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
